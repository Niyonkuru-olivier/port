{
  "name": "storemis-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:env": "node start-server.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:monitor": "node scripts/monitor-db.js",
    "db:health": "curl -f http://localhost:3000/api/health || exit 1",
    "db:backup": "npx prisma db pull && npx prisma generate",
    "start:win": "start-server.bat",
    "start:ps": "powershell -ExecutionPolicy Bypass -File start-server.ps1"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.1.5",
    "@iconify/react": "^5.2.1",
    "@prisma/client": "^5.19.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.8",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.5",
    "next-auth": "^4.24.10",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "pdfkit-table": "^0.1.99",
    "prisma": "^5.19.1",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "20.19.23",
    "@types/nodemailer": "^6.4.19",
    "@types/react": "18.3.26",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3"
  }
}
